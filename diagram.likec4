// GreenGrant architecture model for LikeC4
// Views included:
// - l1_context: C4 System Context Diagram
// - l2_containers: C4 Container Diagram

specification {
  element person
  element softwareSystem
  element container
  element database
  element storage
  element queue
}

model {
  citizenApplicant = person 'Citizen Applicant' {
    description 'Individual citizen applying for green subsidy support.'
  }

  businessApplicant = person 'Business Applicant' {
    description 'Company or organization applying for green subsidy support.'
  }

  administrator = person 'Grant Administrator' {
    description 'Government employee who manages grant programs and reviews applications.'
  }

  seniorAdministrator = person 'Senior Administrator' {
    description 'Supervisor responsible for oversight, reports, and audit review.'
  }

  systemOperator = person 'System Operator' {
    description 'Technical operator responsible for deployment, monitoring, backup, and maintenance.'
  }

  mundamail = softwareSystem 'MundaMail API' {
    description 'External government email service used for official applicant notifications.'
  }

  zamundaHosting = softwareSystem 'Zamunda Government Hosting Environment' {
    description 'Approved local infrastructure where GreenGrant data, services, logs, backups, and AI processing are hosted.'
  }

  greenGrant = softwareSystem 'GreenGrant' {
    description 'Government platform for green subsidy applications, document upload, administrative review, decisions, notifications, and audit logging.'

    applicantPortal = container 'Applicant Web Portal' {
      description 'Responsive web application used by citizens and businesses to browse grants, submit applications, upload documents, and track status.'
      technology 'Web frontend'
    }

    administratorPortal = container 'Administrator Web Portal' {
      description 'Web application used by government staff to create grants, review applications, make decisions, view reports, and inspect audit history.'
      technology 'Web frontend'
    }

    apiGateway = container 'API Gateway' {
      description 'Single controlled entry point for web clients. Routes requests to backend services and supports security enforcement.'
      technology 'HTTPS / REST API'
    }

    identityService = container 'Identity and Access Service' {
      description 'Handles authentication, user roles, sessions or tokens, and role-based access control.'
      technology 'Auth service / RBAC'
    }

    grantService = container 'Grant Management Service' {
      description 'Manages grant programs, deadlines, eligibility rules, scoring rules, required documents, and publication status.'
      technology 'Backend service'
    }

    applicationService = container 'Application Service' {
      description 'Handles draft applications, submitted applications, ownership checks, statuses, and application lifecycle.'
      technology 'Backend service'
    }

    documentService = container 'Document Service' {
      description 'Validates, stores, and retrieves uploaded documents. Keeps document metadata linked to applications.'
      technology 'Backend service'
    }

    reviewService = container 'Review and Evaluation Service' {
      description 'Supports administrative review, scoring, correction requests, approvals, rejections, and final decision recording.'
      technology 'Backend service'
    }

    notificationService = container 'Notification Service' {
      description 'Sends official outcome notifications through MundaMail and handles retry logic and delivery status.'
      technology 'Backend service'
    }

    auditService = container 'Audit Logging Service' {
      description 'Records important actions such as submissions, document changes, reviews, decisions, notifications, and AI usage.'
      technology 'Backend service'
    }

    aiAssistantService = container 'AI Assistant Service' {
      description 'Provides advisory document summaries, missing-information checks, and inconsistency warnings for administrators.'
      technology 'AI service'
    }

    postgres = database 'PostgreSQL Database' {
      description 'Stores structured data: users, grants, applications, statuses, reviews, decisions, notification metadata, and audit metadata.'
      technology 'PostgreSQL'
    }

    objectStorage = storage 'Object Storage' {
      description 'Stores uploaded applicant documents and supporting files inside Zamunda-approved infrastructure.'
      technology 'Object storage'
    }

    eventBroker = queue 'Event Broker / Message Queue' {
      description 'Supports asynchronous workflows such as audit logging, notification delivery, document processing, reporting updates, and AI review requests.'
      technology 'Message broker'
    }

    // User-facing routes
    applicantPortal -> apiGateway 'Calls backend APIs over HTTPS'
    administratorPortal -> apiGateway 'Calls backend APIs over HTTPS'

    // API Gateway routing
    apiGateway -> identityService 'Authenticates users and checks roles'
    apiGateway -> grantService 'Routes grant management and grant browsing requests'
    apiGateway -> applicationService 'Routes application draft, submission, and status requests'
    apiGateway -> documentService 'Routes document upload and download requests'
    apiGateway -> reviewService 'Routes review and decision requests'
    apiGateway -> auditService 'Routes authorized audit queries'

    // Service-to-service relationships
    grantService -> postgres 'Stores grant programs, rules, deadlines, and required documents'
    applicationService -> postgres 'Stores applications, statuses, and ownership data'
    documentService -> postgres 'Stores document metadata'
    documentService -> objectStorage 'Stores and retrieves uploaded documents'
    reviewService -> postgres 'Stores review actions, correction requests, and final decisions'
    reviewService -> applicationService 'Reads application data and updates application status'
    reviewService -> documentService 'Retrieves documents for review'
    reviewService -> aiAssistantService 'Requests advisory AI assistance'
    identityService -> postgres 'Stores users, roles, and access data'

    // Event-driven workflows
    applicationService -> eventBroker 'Publishes ApplicationSubmitted and status events'
    documentService -> eventBroker 'Publishes DocumentUploaded events'
    reviewService -> eventBroker 'Publishes ReviewCompleted and DecisionFinalized events'
    eventBroker -> auditService 'Delivers events for audit logging'
    eventBroker -> notificationService 'Delivers notification requests'
    eventBroker -> aiAssistantService 'Triggers asynchronous AI review tasks'
    eventBroker -> documentService 'Triggers background document processing'

    // Notification and audit persistence
    notificationService -> mundamail 'Sends official decision notifications'
    notificationService -> postgres 'Stores notification delivery status'
    notificationService -> eventBroker 'Publishes NotificationDelivered or NotificationFailed events'
    auditService -> postgres 'Stores protected audit records'

    // AI access and persistence
    aiAssistantService -> documentService 'Reads permitted documents for advisory analysis'
    aiAssistantService -> postgres 'Stores AI assistance metadata when required'
  }

  // External users and systems
  citizenApplicant -> greenGrant.applicantPortal 'Uses to apply for grants and track applications'
  businessApplicant -> greenGrant.applicantPortal 'Uses to submit business grant applications and documents'
  administrator -> greenGrant.administratorPortal 'Uses to manage grants and review applications'
  seniorAdministrator -> greenGrant.administratorPortal 'Uses for oversight, reports, and audit review'
  systemOperator -> greenGrant 'Operates, monitors, backs up, and maintains the platform'

  zamundaHosting -> greenGrant 'Hosts and operates the system inside Zamunda'
}

views {
  view l1_context {
    title 'GreenGrant - System Context Diagram'
    description 'Shows GreenGrant, its main user groups, the external MundaMail API, and Zamunda government hosting.'

    include *
  }

  view l2_containers of greenGrant {
    title 'GreenGrant - Container Diagram'
    description 'Shows the main internal containers/services of GreenGrant and their relationships.'

    include *
    include citizenApplicant
    include businessApplicant
    include administrator
    include seniorAdministrator
    include systemOperator
    include mundamail
    include zamundaHosting
  }
}
